  "cases": [
    {
      "id": "INIT-001",
      "suite": "init",
      "title": "PB-03F完整AT初始化",
      "precondition": "T5L重新上电或复位，电脑端模拟器已打开两路串口",
      "description": "验证T5L在UART2上完成12步PB-03F配置并进入透传。",
      "actions": [],
      "expected": [
        {
          "kind": "at_contains",
          "prefixes": [
            "AT",
            "AT+BLEMODE=9",
            "AT+BLESERUUID=",
            "AT+BLETXUUID=",
            "AT+BLERXUUID=",
            "AT+BLEMTU=240",
            "AT+BLEMAC?",
            "AT+BLEAUTH=",
            "AT+BLENAME=",
            "AT+BLEADVDATA=",
            "AT+BLEMODE=0",
            "AT+TRANSENTER"
          ],
          "description": "UART2依次出现12类AT命令，MAC查询、认证、名称和广播命令均存在。"
        },
        {
          "kind": "at_transition_count",
          "count": 1,
          "description": "PB-03F模拟器至少完成1次透传切换。"
        }
      ]
    },
    {
      "id": "V851-ID-001",
      "suite": "bridge",
      "title": "缓存V851设备身份并重配蓝牙名称",
      "precondition": "INIT-001通过，PB-03F已进入透传",
      "description": "V851上报device.hello后，T5L缓存身份；新的ble_id触发退出透传并重新配置PB-03F。",
      "actions": [
        {
          "port": "v851",
          "kind": "json",
          "json": {
            "msg_id": "HELLO-001",
            "msg_type": "device.hello",
            "protocol_version": "1.0",
            "device_sn": "SN-TEST-0001",
            "ble_id": "ABC234",
            "product_key": "PK-TEST",
            "data": {
              "device_identity": {
                "device_sn": "SN-TEST-0001",
                "ble_id": "ABC234",
                "ble_name": "MQXQ-ABC2",
                "product_key": "PK-TEST",
                "model": "T5L-TEST",
                "hardware_version": "HW-1.0",
                "firmware_version": "FW-1.0",
                "sales_country_code": "CN"
              }
            }
          }
        },
        {
          "kind": "wait_ble_transparent",
          "transition_count": 2,
          "timeout_ms": 15000
        }
      ],
      "expected": [
        {
          "port": "v851",
          "kind": "no_frame",
          "timeout_ms": 800,
          "description": "device.hello本身不产生UART4应答。"
        },
        {
          "kind": "at_transition_count",
          "count": 2,
          "timeout_ms": 15000,
          "description": "UART2先收到+++，随后完成第二轮AT配置并再次进入透传。"
        }
      ],
      "debugger": "V851ProtocolGetDeviceInfo()中的device_sn、ble_id、product_key、model及版本字段与发送值一致。"
    },
    {
      "id": "V851-TIME-001",
      "suite": "bridge",
      "title": "缓存服务器时间与绑定状态",
      "precondition": "V851-ID-001通过",
      "description": "server.hello_ack只更新本地时间基准、国家码和绑定状态，不产生串口应答。",
      "actions": [
        {
          "port": "v851",
          "kind": "json",
          "json": {
            "msg_id": "HELLO-ACK-001",
            "msg_type": "server.hello_ack",
            "timestamp": 2000000000,
            "data": {
              "server_time": 2000000000,
              "bind_status": "BOUND",
              "sales_country_code": "CN"
            }
          }
        }
      ],
      "expected": [
        {
          "port": "v851",
          "kind": "no_frame",
          "timeout_ms": 800,
          "description": "server.hello_ack不产生UART4应答。"
        }
      ],
      "debugger": "V851ProtocolGetTimestamp()不小于2000000000，bind_status为BOUND。"
    },
    {
      "id": "BLE-INFO-001",
      "suite": "bridge",
      "title": "蓝牙查询设备信息",
      "precondition": "身份、绑定状态和PB-03F MAC均已缓存",
      "description": "手机侧get_device_info由T5L本地处理，不转发给V851。",
      "actions": [
        {
          "port": "ble",
          "kind": "json",
          "msg_id": 257,
          "json": {
            "cmd": "get_device_info",
            "request_id": "REQ-INFO-001",
            "data": {}
          }
        }
      ],
      "expected": [
        {
          "port": "ble",
          "kind": "json",
          "match": {
            "cmd": "get_device_info_ack",
            "request_id": "REQ-INFO-001",
            "result": "OK",
            "error_code": null,
            "data": {
              "mac": "A1B2C3D4E5F6",
              "device_sn": "SN-TEST-0001",
              "ble_id": "ABC234",
              "ble_name": "MQXQ-ABC2",
              "product_key": "PK-TEST",
              "model": "T5L-TEST",
              "hardware_version": "HW-1.0",
              "firmware_version": "FW-1.0",
              "sales_country_code": "CN",
              "bind_status": "BOUND"
            }
          },
          "description": "UART2返回get_device_info_ack，身份、MAC、名称和绑定状态正确。"
        },
        {
          "port": "v851",
          "kind": "no_frame",
          "timeout_ms": 500,
          "description": "UART4无转发数据。"
        }
      ]
    },
    {
      "id": "BLE-NET-001",
      "suite": "bridge",
      "title": "蓝牙配网请求转发到V851",
      "precondition": "PB-03F处于透传状态",
      "description": "合法configure_network应保持JSON内容并封装成AA55帧发往UART4。",
      "actions": [
        {
          "port": "ble",
          "kind": "json",
          "msg_id": 258,
          "json": {
            "cmd": "configure_network",
            "request_id": "REQ-NET-001",
            "data": {
              "ssid": "TestWiFi",
              "password": "12345678"
            }
          }
        }
      ],
      "expected": [
        {
          "port": "v851",
          "kind": "json",
          "match": {
            "cmd": "configure_network",
            "request_id": "REQ-NET-001",
            "data": {
              "ssid": "TestWiFi",
              "password": "12345678"
            }
          },
          "description": "UART4收到与蓝牙请求等价的configure_network JSON。"
        }
      ]
    },
    {
      "id": "V851-NET-ACK-001",
      "suite": "bridge",
      "title": "V851配网应答转回蓝牙",
      "precondition": "BLE-NET-001已完成",
      "description": "V851的configure_network_ack属于允许转回蓝牙的应答。",
      "actions": [
        {
          "port": "v851",
          "kind": "json",
          "json": {
            "cmd": "configure_network_ack",
            "request_id": "REQ-NET-001",
            "result": "OK",
            "error_code": null,
            "message": null,
            "data": {
              "ip": "192.168.1.100"
            }
          }
        }
      ],
      "expected": [
        {
          "port": "ble",
          "kind": "json",
          "match": {
            "cmd": "configure_network_ack",
            "request_id": "REQ-NET-001",
            "result": "OK",
            "data": {
              "ip": "192.168.1.100"
            }
          },
          "description": "UART2收到分片封装后的configure_network_ack。"
        }
      ]
    },
    {
      "id": "V851-NET-STATUS-001",
      "suite": "bridge",
      "title": "V851网络状态转回蓝牙",
      "precondition": "PB-03F处于透传状态",
      "description": "network_status属于允许转回蓝牙的异步消息。",
      "actions": [
        {
          "port": "v851",
          "kind": "json",
          "json": {
            "cmd": "network_status",
            "request_id": "REQ-NET-001",
            "result": "OK",
            "data": {
              "connected": true,
              "rssi": -45
            }
          }
        }
      ],
      "expected": [
        {
          "port": "ble",
          "kind": "json",
          "match": {
            "cmd": "network_status",
            "data": {
              "connected": true,
              "rssi": -45
            }
          },
          "description": "UART2收到network_status。"
        }
      ]
    },
    {
      "id": "BLE-UNSUPPORTED-001",
      "suite": "ble_negative",
      "title": "蓝牙不支持的业务命令",
      "precondition": "PB-03F处于透传状态",
      "description": "除get_device_info和configure_network外的命令由T5L直接拒绝。",
      "actions": [
        {
          "port": "ble",
          "kind": "json",
          "msg_id": 259,
          "json": {
            "cmd": "reboot",
            "request_id": "REQ-BAD-001",
            "data": {}
          }
        }
      ],
      "expected": [
        {
          "port": "ble",
          "kind": "json",
          "match": {
            "cmd": "reboot_ack",
            "request_id": "REQ-BAD-001",
            "result": "FAIL",
            "error_code": "UNSUPPORTED_CMD",
            "message": "command is not supported by T5L"
          },
          "description": "UART2返回UNSUPPORTED_CMD。"
        }
      ]
    },
    {
      "id": "BLE-FIELDS-001",
      "suite": "ble_negative",
      "title": "蓝牙JSON缺少必要字段",
      "precondition": "PB-03F处于透传状态",
      "description": "缺少cmd或request_id时返回INVALID_PAYLOAD。",
      "actions": [
        {
          "port": "ble",
          "kind": "json",
          "msg_id": 260,
          "json": {
            "request_id": "REQ-BAD-002",
            "data": {}
          }
        }
      ],
      "expected": [
        {
          "port": "ble",
          "kind": "json",
          "match": {
            "cmd": "unknown_ack",
            "request_id": null,
            "result": "FAIL",
            "error_code": "INVALID_PAYLOAD",
            "message": "cmd or request_id is missing"
          },
          "description": "UART2返回unknown_ack和INVALID_PAYLOAD。"
        }
      ]
    },
    {
      "id": "V851-CTL-EXHAUST",
      "suite": "v851_control",
      "title": "排风控制命令",
      "precondition": "V851-TIME-001通过",
      "description": "验证exhaust.set参数写入0x3000并返回成功应答。",
      "actions": [
        {
          "port": "v851",
          "kind": "json",
          "json": {
            "msg_id": "MSG-EXHAUST",
            "msg_type": "server.command",
            "data": {
              "command_id": "CMD-EXHAUST",
              "cmd": "exhaust.set",
              "expire_at": 0,
              "params": {
                "enabled": true,
                "level": 3
              }
            }
          }
        }
      ],
      "expected": [
        {
          "port": "v851",
          "kind": "json",
          "match": {
            "msg_type": "device.command_ack",
            "device_sn": "SN-TEST-0001",
            "ble_id": "ABC234",
            "data": {
              "command_id": "CMD-EXHAUST",
              "server_msg_id": "MSG-EXHAUST",
              "status": "SUCCESS",
              "result": {
                "cmd": "exhaust.set",
                "executed": true,
                "applied": {
                  "enabled": true,
                  "level": 3
                }
              }
            }
          },
          "description": "UART4返回SUCCESS及实际应用参数。"
        }
      ],
      "debugger": "0x3000为1、0x3001为3；V851ControlInfoGet(V851_CONTROL_EXHAUST)有效且updated=1。"
    },
